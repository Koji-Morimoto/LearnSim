#usda 1.0
(
    defaultPrim = "openarm"
    doc = "Pedestal/body-only base layer isolating /openarm/openarm_body_link and /openarm/root_joint from official Isaac Sim 6.2 OpenArm bimanual asset (arms and shoulder-base link0 visuals/colliders deactivated and PhysicsRigidBodyAPI deleted so two identical openarm_unimanual arms can be mounted cleanly via assembly_pipeline.v2)."
    metersPerUnit = 1
    subLayers = [
        @./_s3_cache/Isaac/Robots/OpenArm/openarm_bimanual/configuration/openarm_bimanual_physics.usd@
    ]
    upAxis = "Z"
)

over "openarm" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    rel isaac:physics:robotJoints = [
        </openarm/root_joint>,
    ]
    rel isaac:physics:robotLinks = [
        </openarm/openarm_body_link>,
    ]

    over "openarm_body_link" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        over "openarm_left_link0" (
            active = false
        )
        {
        }

        over "openarm_right_link0" (
            active = false
        )
        {
        }
    }

    over "joints" (
        active = false
    )
    {
    }

    over "openarm_left_link1" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_left_link2" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_left_link3" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_left_link4" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_left_link5" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_left_link6" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_left_link7" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_left_right_finger" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_left_left_finger" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_left_hand" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_left_ee_tcp" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_right_link1" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_right_link2" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_right_link3" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_right_link4" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_right_link5" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_right_link6" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_right_link7" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_right_right_finger" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_right_left_finger" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_right_hand" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }

    over "openarm_right_ee_tcp" (
        active = false
        delete apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
    }
}

over "visuals"
{
    over "openarm_body_link"
    {
        over "openarm_left_link0_visual" (
            active = false
        )
        {
        }

        over "openarm_right_link0_visual" (
            active = false
        )
        {
        }
    }
}

over "colliders"
{
    over "openarm_body_link"
    {
        over "openarm_left_link0_collision" (
            active = false
        )
        {
        }

        over "openarm_right_link0_collision" (
            active = false
        )
        {
        }
    }
}
