<?xml version="1.0"?>
<robot name="arm">
  <link name="base_link"><inertial><origin xyz="0 0 0"/><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial><visual><origin xyz="0 0 0.05"/><geometry><mesh filename="../meshes/base.stl"/></geometry></visual><collision><origin xyz="0 0 0.05"/><geometry><mesh filename="../meshes/base.stl"/></geometry></collision></link>
  <link name="link1"><inertial><origin xyz="0 0 0"/><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial><visual><origin xyz="0 0 0.2"/><geometry><mesh filename="../meshes/link.stl"/></geometry></visual><collision><origin xyz="0 0 0.2"/><geometry><mesh filename="../meshes/link.stl"/></geometry></collision></link>
  <link name="link2"><inertial><origin xyz="0 0 0"/><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial><visual><origin xyz="0 0 0.2"/><geometry><mesh filename="../meshes/link.stl"/></geometry></visual><collision><origin xyz="0 0 0.2"/><geometry><mesh filename="../meshes/link.stl"/></geometry></collision></link>
  <link name="flange"/>
  <joint name="j1" type="revolute"><parent link="base_link"/><child link="link1"/><origin xyz="0 0 0.1"/><axis xyz="0 0 1"/><limit lower="-3.0" upper="3.0" effort="100" velocity="2"/></joint>
  <joint name="j2" type="revolute"><parent link="link1"/><child link="link2"/><origin xyz="0 0 0.4"/><axis xyz="0 1 0"/><limit lower="-3.0" upper="3.0" effort="100" velocity="2"/></joint>
  <joint name="flange_joint" type="fixed"><parent link="link2"/><child link="flange"/><origin xyz="0 0 0.4"/></joint>
</robot>
