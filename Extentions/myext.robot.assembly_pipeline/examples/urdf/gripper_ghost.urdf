<?xml version="1.0"?>
<robot name="gripper_ghost">
  <link name="gripper_mount"/>
  <joint name="mount_joint" type="fixed"><parent link="gripper_mount"/><child link="gripper_base"/><origin xyz="0 0 0"/></joint>
  <link name="gripper_base"><inertial><origin xyz="0 0 0"/><mass value="0.3"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial><visual><origin xyz="0 0 0.02"/><geometry><mesh filename="../meshes/palm.stl"/></geometry></visual><collision><origin xyz="0 0 0.02"/><geometry><mesh filename="../meshes/palm.stl"/></geometry></collision></link>
  <link name="finger_l"><inertial><origin xyz="0 0 0"/><mass value="0.05"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial><visual><origin xyz="0 0 0.03"/><geometry><mesh filename="../meshes/finger.stl"/></geometry></visual><collision><origin xyz="0 0 0.03"/><geometry><mesh filename="../meshes/finger.stl"/></geometry></collision></link>
  <link name="finger_r"><inertial><origin xyz="0 0 0"/><mass value="0.05"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial><visual><origin xyz="0 0 0.03"/><geometry><mesh filename="../meshes/finger.stl"/></geometry></visual><collision><origin xyz="0 0 0.03"/><geometry><mesh filename="../meshes/finger.stl"/></geometry></collision></link>
  <joint name="finger_l_joint" type="prismatic"><parent link="gripper_base"/><child link="finger_l"/><origin xyz="0 0.02 0.04"/><axis xyz="0 1 0"/><limit lower="0.0" upper="0.04" effort="100" velocity="2"/></joint>
  <joint name="finger_r_joint" type="prismatic"><parent link="gripper_base"/><child link="finger_r"/><origin xyz="0 -0.02 0.04"/><axis xyz="0 -1 0"/><limit lower="0.0" upper="0.04" effort="100" velocity="2"/><mimic joint="finger_l_joint" multiplier="1" offset="0"/></joint>
</robot>
