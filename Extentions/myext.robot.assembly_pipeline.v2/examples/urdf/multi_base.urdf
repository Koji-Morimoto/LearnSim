<?xml version="1.0"?>
<!-- 検証用のベース。台(base_body)の上に回転する台座(turret)があり、台座の四隅に取り付け用の空のリンク port1〜port4 がある -->
<robot name="multi_base">
  <link name="base_body">
    <inertial><origin xyz="0 0 0"/><mass value="20"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
    <visual><origin xyz="0 0 0.1"/><geometry><box size="0.8 0.8 0.2"/></geometry></visual>
    <collision><origin xyz="0 0 0.1"/><geometry><box size="0.8 0.8 0.2"/></geometry></collision>
  </link>
  <link name="turret">
    <inertial><origin xyz="0 0 0"/><mass value="10"/><inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.5"/></inertial>
    <visual><origin xyz="0 0 0.05"/><geometry><box size="0.7 0.7 0.1"/></geometry></visual>
    <collision><origin xyz="0 0 0.05"/><geometry><box size="0.7 0.7 0.1"/></geometry></collision>
  </link>
  <joint name="turret_joint" type="revolute">
    <parent link="base_body"/><child link="turret"/><origin xyz="0 0 0.2"/>
    <axis xyz="0 0 1"/><limit lower="-1.5" upper="1.5" effort="500" velocity="1"/>
  </joint>
  <link name="port1"/>
  <link name="port2"/>
  <link name="port3"/>
  <link name="port4"/>
  <joint name="port1_joint" type="fixed"><parent link="turret"/><child link="port1"/><origin xyz="0.3 0.3 0.1"/></joint>
  <joint name="port2_joint" type="fixed"><parent link="turret"/><child link="port2"/><origin xyz="-0.3 0.3 0.1"/></joint>
  <joint name="port3_joint" type="fixed"><parent link="turret"/><child link="port3"/><origin xyz="-0.3 -0.3 0.1"/></joint>
  <joint name="port4_joint" type="fixed"><parent link="turret"/><child link="port4"/><origin xyz="0.3 -0.3 0.1"/></joint>
</robot>
