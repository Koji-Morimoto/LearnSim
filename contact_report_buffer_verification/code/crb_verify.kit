# ContactReport バッファ検証専用の軽量エクスペリエンス。
# 同じ Isaac Sim 6.2.0 インストールの omni.physx を使い、描画・UI 系だけを外す。
# 理由: 以前の検証でフルアプリの起動が bad allocation で止まったため(physx_overlap_contact_verification 参照)。
[package]
title = "ContactReport buffer verification"
version = "6.2.0"

[dependencies]
"omni.kit.loop-isaac" = {}
"omni.usd" = {}
"omni.usd.libs" = {}
"omni.timeline" = {}
"omni.usd.schema.physx" = {}
"omni.usdphysics" = {}
"omni.physics" = {}
"omni.physx.foundation" = {}
"omni.physx.cooking" = {}
"omni.physx.gpu" = {}
"omni.physx" = {}
"omni.physics.physx" = {}
"omni.physics.stageupdate" = {}
"omni.kit.async_engine" = {}
"omni.kit.usd.layers" = {}
"omni.kit.stage_templates" = {}
# get_initial_collider_pairs (検出器の本体) が usdrt を import するため
"usdrt.scenegraph" = {}

# 以下は isaacsim.exp.base.kit の物理関連設定と同じ値
[settings]
physics.autoPopupSimulationOutputWindow = false
physics.resetOnStop = true

[settings.app]
name = "ContactReport buffer verification"
version = "6.2.0"
settings.persistent = false
renderer.skipWhileMinimized = true

[settings.persistent]
physics.visualizationDisplayJoints = false
physics.visualizationSimulationOutput = false

[settings.app.exts.folders]
'++' = [
    "C:/isaacsim-6.2.0/exts",
    "C:/isaacsim-6.2.0/extscache",
    "C:/isaacsim-6.2.0/kit/exts",
    "C:/isaacsim-6.2.0/kit/extscore",
]
