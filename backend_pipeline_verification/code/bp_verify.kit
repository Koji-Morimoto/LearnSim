# バックエンド(usd / usdrt / fabric / tensor)検証専用の軽量エクスペリエンス。
# 同じ Isaac Sim 6.2.0 インストールの拡張を使い、描画・UI 系だけを外す。
# 理由: 以前の検証でフルアプリの起動が bad allocation で止まったため(physx_overlap_contact_verification 参照)。
# omni.physx.fabric はここでは有効にしない。必要な検証では SimulationManager.enable_fabric(True) で実行時に有効にする。
[package]
title = "Backend pipeline verification"
version = "6.2.0"

[dependencies]
"omni.kit.loop-isaac" = {}
"omni.usd" = {}
"omni.usd.libs" = {}
"omni.timeline" = {}
"omni.usd.schema.physx" = {}
"omni.usdphysics" = {}
"omni.physics" = {}
"omni.physx.foundation" = {}
"omni.physx.cooking" = {}
"omni.physx.gpu" = {}
"omni.physx" = {}
"omni.physics.physx" = {}
"omni.physics.stageupdate" = {}
"omni.physics.tensors" = {}
"omni.physx.tensors" = {}
"omni.kit.async_engine" = {}
"omni.kit.usd.layers" = {}
"omni.kit.stage_templates" = {}
"usdrt.scenegraph" = {}
"omni.hydra.usdrt_delegate" = {}
"isaacsim.core.simulation_manager" = {}
"isaacsim.core.experimental.utils" = {}
"isaacsim.core.experimental.prims" = {}

[settings]
physics.autoPopupSimulationOutputWindow = false
physics.resetOnStop = true                # isaacsim.exp.base.kit と同じ

[settings.app]
name = "Backend pipeline verification"
version = "6.2.0"
settings.persistent = false
renderer.skipWhileMinimized = true
useFabricSceneDelegate = true             # isaacsim.exp.base.kit と同じ。usdrt / fabric バックエンドの前提条件

[settings.persistent]
physics.visualizationDisplayJoints = false
physics.visualizationSimulationOutput = false

[settings.app.exts.folders]
'++' = [
    "C:/isaacsim-6.2.0/exts",
    "C:/isaacsim-6.2.0/extscache",
    "C:/isaacsim-6.2.0/extsDeprecated",
    "C:/isaacsim-6.2.0/kit/exts",
    "C:/isaacsim-6.2.0/kit/extscore",
]
